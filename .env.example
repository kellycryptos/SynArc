# Syn DAO Frontend Configuration
# This is a template for environment variables. Copy to .env.local and fill in values.
# IMPORTANT: .env.local is git-ignored and should never be committed.

# === Authentication ===
# Privy App ID for wallet authentication
NEXT_PUBLIC_PRIVY_APP_ID=clt57262n00ldmp0fhz113qep

# WalletConnect / Reown Cloud Project ID (for RainbowKit / mobile wallet QR modal)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# === Network Selection & RPC Configuration ===
NEXT_PUBLIC_ARC_NETWORK=mainnet

# Official Arc RPC Endpoints
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# Alternative / Provider RPCs (Optional)
NEXT_PUBLIC_CANTEEN_TESTNET_RPC=
NEXT_PUBLIC_CANTEEN_MAINNET_RPC=
NEXT_PUBLIC_ALCHEMY_MAINNET_RPC=
NEXT_PUBLIC_ALCHEMY_TESTNET_RPC=
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# === Governance Contracts (Arc Testnet - Chain ID: 5042002) ===
# Live deployed contract addresses on Arc Testnet
NEXT_PUBLIC_GOVERNOR_ADDRESS=0x83Fa2adf3f66e4951D7E9F2576a79e9d644aE25e
NEXT_PUBLIC_TOKEN_ADDRESS=0xBd0C6b83DaBF2c04Ab762C262ea0B036d2D1368e
NEXT_PUBLIC_TREASURY_ADDRESS=0xFE0F6bF45D363d34CD5fC1781594a7471736dC18
NEXT_PUBLIC_TREASURY_AGENT_ADDRESS=0xE6bAC65d7f060B805B8dd6f1c4DBfa6571905f28
NEXT_PUBLIC_EURC_CONTRACT_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
NEXT_PUBLIC_CROWDFUND_ADDRESS=0xd5374DFC4B01F60115A52Df027704062506b3030

# === Governance Contracts (Arc Mainnet - Chain ID: 5042 Placeholder) ===
# Fill in once deployed on Arc Mainnet
NEXT_PUBLIC_MAINNET_GOVERNOR_ADDRESS=
NEXT_PUBLIC_MAINNET_TOKEN_ADDRESS=
NEXT_PUBLIC_MAINNET_TREASURY_ADDRESS=
NEXT_PUBLIC_MAINNET_TREASURY_AGENT_ADDRESS=
NEXT_PUBLIC_MAINNET_EURC_CONTRACT_ADDRESS=
NEXT_PUBLIC_MAINNET_TOKEN_MESSENGER_ADDRESS=
NEXT_PUBLIC_MAINNET_CROWDFUND_ADDRESS=


# === Environment Mode ===
# Options: development, staging, production
NEXT_PUBLIC_ENVIRONMENT=development
# Official production domain URL
NEXT_PUBLIC_SITE_URL=https://www.synarcdao.xyz/

# === Server-side Secrets (never expose to frontend) ===
# These should ONLY be set on the server or in CI/CD, never in NEXT_PUBLIC_* variables
# Privy webhook signing key (for API routes only)
PRIVY_WEBHOOK_SIGNING_KEY=your_privy_webhook_signing_key_here

# Deployment credentials (for scripts/deploy.ts only)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here
ARC_RPC_URL=https://rpc.testnet.arc.network

# === Circle Integration ===
# Circle User-Controlled Wallet App ID (Developer -> Apps on app.circle.com)
NEXT_PUBLIC_CIRCLE_APP_ID="your_circle_app_id_here"
# Circle API Key (already set on server, server-side only)
CIRCLE_API_KEY="your_circle_api_key_here"

# === Groq Integration ===
# Groq API Key for AI Agent Governance (server-side only, never prefix with NEXT_PUBLIC_)
GROQ_API_KEY="your_groq_api_key_here"

# === Cron Security ===
# A random 64-character hex secret shared between this server and cron-job.org.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value as the "x-cron-secret" custom header in your cron-job.org job.
# Also add this as a Vercel Environment Variable (server-only, no NEXT_PUBLIC_ prefix).
CRON_SECRET="generate_a_64_char_hex_secret_here"
